+def _sx1301_backend() -> bool:
+    """True when this install runs the patched SX1301 backend.
+
+    The updater resets the tree to origin/<branch>. That discards the local
+    SX1301 patches, so an in-app update would silently turn a working gateway
+    into one that cannot open the concentrator.
+    """
+    try:
+        from src.config import load_config
+        return load_config().capture.concentrator_backend == "sx1301"
+    except Exception:
+        return False
+
